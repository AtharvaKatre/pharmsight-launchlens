# Optional overrides for `docker compose up`. Copy to `.env` (next to docker-compose.yml) to use.
# Compose reads this file automatically; nothing here is required for a local demo.

# Replace the development-only JWT signing secret (at least 32 characters). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# Host port for the web app (default 8080).
# PHARMSIGHT_WEB_PORT=8080

# Host port (bound to 127.0.0.1) for PostgreSQL, used when running the backend or its tests outside Docker.
# PHARMSIGHT_DB_PORT=55432
