# Only needed to run the backend or its tests OUTSIDE Docker (with `docker compose up -d db`).
# Copy to .env: the backend loads it automatically. Real environment variables override it.
# Port 55432 matches the database port published by docker-compose.yml.

DATABASE_URL=postgresql+psycopg://launchlens:launchlens@127.0.0.1:55432/launchlens

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database used by the API test suite (created by backend/docker/postgres-init).
TEST_DATABASE_URL=postgresql+psycopg://launchlens:launchlens@127.0.0.1:55432/launchlens_test
