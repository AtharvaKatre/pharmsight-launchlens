# Copy to .env for local development: the backend loads it automatically.
# Real environment variables override values in .env.

DATABASE_URL=postgresql+psycopg://pharmsight:pharmsight@localhost:5432/pharmsight

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database used by the API test suite (created by docker/postgres-init).
TEST_DATABASE_URL=postgresql+psycopg://pharmsight:pharmsight@localhost:5432/pharmsight_test
